From 92dc56dca46f9b8883be6f39a32b579533baa00a Mon Sep 17 00:00:00 2001
From: Garrett Brown <garrett.brown@aclima.io>
Date: Tue, 1 Oct 2024 11:28:07 -0700
Subject: [PATCH] Allow UPD on private networks in ufw firewall

---
 curie_stack/scripts/shell/firewall_enable.sh | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/curie_stack/scripts/shell/firewall_enable.sh b/curie_stack/scripts/shell/firewall_enable.sh
index a7528c80..50fc8431 100755
--- a/curie_stack/scripts/shell/firewall_enable.sh
+++ b/curie_stack/scripts/shell/firewall_enable.sh
@@ -27,6 +27,11 @@ ufw allow ssh
 # Allow https
 ufw allow https
 
+# Allow UDP on private networks
+ufw allow from 10.0.0.0/8 to any proto udp
+ufw allow from 172.16.0.0/12 to any proto udp
+ufw allow from 192.168.0.0/16 to any proto udp
+
 # Print the rules for the user to see
 echo ""
 ufw status
-- 
